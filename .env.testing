# Testing Environment Configuration
# Copy this to .env for testing without Google Cloud

# Enable testing mode (bypasses authentication)
TESTING_MODE=true

# Enable mock services (no Google Cloud required)
USE_MOCK_SERVICES=true

# JWT Configuration (for any auth that still runs)
JWT_SECRET_KEY=test-secret-key-for-development-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Cloud (optional - only needed for production)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Firebase (optional - only needed for production auth)
# FIREBASE_PROJECT_ID=your-project-id
