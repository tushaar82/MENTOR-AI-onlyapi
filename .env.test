# Test Environment Configuration for Mentor AI Platform

# Server Configuration
API_BASE_URL=http://localhost:8000

# Test Credentials
TEST_EMAIL=test@example.com
TEST_PASSWORD=TestPass123
TEST_PHONE=+919876543210
TEST_CHILD_USERNAME=teststudent123
TEST_CHILD_PASSWORD=TestPass123

# Firebase Configuration (using test credentials)
FIREBASE_CREDENTIALS_PATH=config/firebase-credentials.json
FIREBASE_PROJECT_ID=mentor-ai-test
FIREBASE_API_KEY=test_firebase_api_key

# JWT Configuration
JWT_SECRET_KEY=test_secret_key_for_development_only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini API Configuration (test key)
GOOGLE_API_KEY=test_gemini_api_key

# Testing Mode
TESTING_MODE=true
USE_MOCK_SERVICES=false

# Rate Limiting (relaxed for testing)
RATE_LIMIT_SEARCH=100
RATE_LIMIT_EMBEDDING=100

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/test.log